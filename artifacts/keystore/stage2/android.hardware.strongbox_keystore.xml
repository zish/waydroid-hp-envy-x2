<?xml version="1.0" encoding="utf-8"?>
<!--
  docs/65 / docs/73 stage 2: declares FEATURE_STRONGBOX_KEYSTORE so PackageManager
  advertises a hardware "secure element" to apps (setIsStrongBoxBacked(true)).

  Overlay target: /system/etc/permissions/android.hardware.strongbox_keystore.xml
  This file ALONE is the lower-risk half of stage 2 (PackageManager-facing). It
  does not by itself create a working StrongBox instance -- apps that ask for
  StrongBox-backed keys will fail at generation until stage 3 serves the HIDL
  instance. Apply it first, confirm `pm has-feature android.hardware.strongbox_keystore`,
  then add the VINTF fragment. See README.md -- this is an attended, reversible test.
-->
<permissions>
    <feature name="android.hardware.strongbox_keystore" />
</permissions>
