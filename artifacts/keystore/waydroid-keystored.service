# The TPM-backed StrongBox keymaster for Waydroid's Android (goal 10).
#
# Installed by artifacts/keystore/install.sh, packaged as waydroid-ext-keystored.
# What it serves is docs/74; why this unit is shaped the way it is, docs/75.
# `systemctl disable --now waydroid-keystored` stops it -- but if
# waydroid-ext-strongbox is installed, Android's manifest still declares the
# strongbox it serves, which is the one combination never booted (docs/65 open
# question 4). Remove that package first.

[Unit]
Description=TPM-backed StrongBox keymaster for Waydroid's Android
Documentation=https://github.com/zish/waydroid-hp-envy-x2/blob/HEAD/docs/75-keystore-packaging.md

# The TPM. Wants= and not Requires=: on a host with a hardware TPM 2.0 the conf
# points --tcti at /dev/tpmrm0 and waydroid-swtpm need not exist, and a Wants=
# naming a unit that is not installed is simply nothing. A TPM that is not ready
# is not fatal either way -- the daemon still registers, so a declared strongbox
# always has something behind it, and key operations fail until the TPM answers.
Wants=waydroid-swtpm.service
After=waydroid-swtpm.service

# The binder device, by its binderfs name and not /dev/hwbinder, which is a
# symlink made by waydroid-container.service's ExecStartPre -- the reason
# waydroid-wifid.service names /dev/binderfs/binder.
Requires=dev-binderfs.mount
After=dev-binderfs.mount

# Not ordered against waydroid-container.service or any session. The daemon
# waits for a session by itself -- id.waydro.Container's GetSession, which costs
# no binder traffic, then the session's hwservicemanager -- and exits when the
# session ends; Restart= brings it back to wait for the next one.
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=-/etc/waydroid-keystored.conf
ExecStart=@BINDIR@/waydroid-keystored $WAYDROID_KEYSTORED_ARGS /dev/binderfs/hwbinder

# The domain it was developed and verified in (docs/73, docs/74), as
# waydroid-wifid.service does. This pins a known-good domain rather than fixing
# a known denial: measured on bigtab01 with selinux_check_access(),
# unconfined_service_t -- what systemd would give a bin_t binary -- holds every
# binder permission keymaster@4.0 uses, calls both ways and the transfer of our
# own object to hwservicemanager. What it lacks is container_runtime_t passing a
# binder TO us, which this interface never does. A different domain would be a
# different, untested daemon, and each test of it costs the owner a logout.
SELinuxContext=system_u:unconfined_r:unconfined_t:s0

# The tpm2-tools backend passes key blobs and operation data through files in a
# 0700 mkdtemp() directory under /tmp. Root's own either way; a private /tmp
# keeps them out of every other process's view as well, and the daemon shares
# nothing through /tmp, so it costs nothing.
PrivateTmp=yes

# The daemon exits 0 at the end of every session on purpose, so this is what
# starts the wait for the next one. A crash takes the same path.
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
