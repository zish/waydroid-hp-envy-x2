#!/bin/bash
#
# waydroid-wifi-sync -- make NetworkManager the source of truth for the Wi-Fi
# networks Android knows about.
#
# Installed at /usr/local/bin/waydroid-wifi-sync, run by waydroid-wifi-sync.timer.
# See docs/36-wifi-credential-sync.md.
#
# WHY THIS EXISTS
#
# waydroid-wifid carries credentials in ONE direction.  Android holds its own
# copy of every passphrase in /data/misc/apexdata/com.android.wifi/
# WifiConfigStore.xml, pushes it down on each connect via setPskPassphrase, and
# NmBackend::connect() then calls Update on the profile -- so NetworkManager is a
# write-through projection of Android's config and a host-side edit is silently
# overwritten.  A network joined on the host is invisible to Android entirely.
#
# The supplicant seam cannot fix that: its AIDL has no "here are my saved
# networks" direction, and Android never asks.  But `cmd wifi add-network` does
# exactly this job, so the reconciliation happens here instead, from the host,
# in the same shape as waydroid-wifi-nudge.
#
# WHAT IT DOES
#
#   * imports every allow-listed NM profile into Android's saved networks
#   * deletes the NM profile when the corresponding network is forgotten in
#     Android -- guarded heavily, see canDelete() and the mass-forget check
#
# It is idempotent and safe to run on a timer: add-network is documented as
# "Add/update saved network", so re-importing an unchanged network is a no-op
# from the user's point of view.

set -u

SHARE_CONF="${SHARE_CONF:-/etc/waydroid-wifi-share.conf}"
STATE="${STATE:-/var/lib/waydroid/waydroid-wifi-sync.state}"

# Refuse to act on a wholesale disappearance.  A factory reset, a container
# reinstall or a wiped WifiConfigStore.xml makes every imported network look
# forgotten at once, and honouring that would delete the host's Wi-Fi profiles
# -- including, potentially, the one this machine is administered over.  A
# person forgetting networks does it one at a time.
MAX_FORGETS_PER_RUN="${MAX_FORGETS_PER_RUN:-1}"

log() { echo "waydroid-wifi-sync: $*" >&2; }

# waydroid appends its own noise to every command and not all of it goes to
# stderr; strip it so we compare Android's answers and not waydroid's chatter.
ash() {
	waydroid shell -- "$@" 2>/dev/null |
		sed -e '/Errno 13/d' -e '/--details-to-stdout/d' -e '/^ *\/usr/d' |
		tr -d '\r'
}

[ "$(id -u)" -eq 0 ] || { log "must run as root"; exit 1; }

# One at a time.  The timer and the daemon's Wi-Fi-enable trigger can fire
# together, and two runs racing would interleave their reads of the state file
# -- the file that licenses DELETIONS.  A second run simply drops out; there is
# nothing useful for it to do that the first is not already doing.
LOCK=/run/waydroid-wifi-sync.lock
# Braces, not a bare `exec 9>... 2>/dev/null`. A redirection on a bare `exec`
# applies to the SHELL for the rest of its life, so that form silently sent every
# log line of this script to /dev/null -- runs completed correctly and reported
# nothing at all. Scoping it to the group keeps stderr intact.
{ exec 9>"$LOCK"; } 2>/dev/null || true
if ! flock -n 9 2>/dev/null; then
	log "another sync is already running"
	exit 0
fi

# Not a sync target if Android is not up; a fresh boot will be caught by the
# next timer tick, and acting mid-boot races WifiConfigStore's own load.
booted=$(ash getprop sys.boot_completed | head -1 | tr -d '[:space:]')
if [ "$booted" != "1" ]; then
	log "Android is not booted yet"
	exit 0
fi

# ----------------------------------------------------------------- allow-list
#
# READ BEFORE THE REAP BUT GATED AFTER IT.  The two halves of this script have
# different scopes, and the allow-list governs only one of them.  Importing
# host-owned profiles into Android, and deleting them when Android forgets them,
# is opt-in because those profiles belong to the machine's owner.  The daemon's
# own "(Waydroid)" projections are ours outright, so reaping a stale one needs
# nobody's permission -- and gating the reap behind the allow-list would mean a
# host with nothing opted in, which is the default, never reaps anything.
#
# So the list is parsed here, because `nodelete` has to be able to protect an
# SSID in both halves, and the early exit on an absent or empty one moves down
# past the reap.
# A line is an SSID, optionally followed by whitespace and the word "nodelete".
# Everything before that keyword is the SSID, so an SSID with spaces still works.
NODELETE=()
WANTED=()
# Readable-check inline, because the exit on an absent file is now down past the
# reap: without this, a host with nothing opted in -- the default -- would emit a
# redirection error on every run before reaching the message that explains it.
while IFS= read -r line; do
	line=${line%%#*}
	line=${line#"${line%%[![:space:]]*}"}
	line=${line%"${line##*[![:space:]]}"}
	[ -n "$line" ] || continue
	case "$line" in
	*[[:space:]]nodelete)
		ssid=${line%nodelete}
		ssid=${ssid%"${ssid##*[![:space:]]}"}
		WANTED+=("$ssid")
		NODELETE+=("$ssid")
		;;
	*)
		WANTED+=("$line")
		;;
	esac
done < <([ -r "$SHARE_CONF" ] && cat "$SHARE_CONF")

# Marked "nodelete": share it with Android, but never let a forget in Android
# remove the host's profile.  The right setting for any network the host itself
# depends on -- the active-profile guard below protects a profile that is up at
# that moment, and a profile the host has merely brought down for a minute is
# not protected by anything else.
nodelete_contains() {
	local s
	for s in ${NODELETE[@]+"${NODELETE[@]}"}; do [ "$s" = "$1" ] && return 0; done
	return 1
}

# The ${a[@]+...} guard matches nodelete_contains() above. It used to be
# unnecessary here because the "names no networks" exit sat between the parse and
# this function; that exit is now below the reap, so an empty WANTED can reach
# this under `set -u`.
wanted_contains() {
	local s
	for s in ${WANTED[@]+"${WANTED[@]}"}; do [ "$s" = "$1" ] && return 0; done
	return 1
}

# ------------------------------------------------------- what Android now has
#
# Parsed positionally rather than by column width: an SSID may contain spaces,
# but a network id never does and a security type never does, so first field and
# last field are unambiguous and everything between them is the SSID.
#
# Ids repeat.  Android 13 adds an SAE parameter alongside WPA2 for auto-upgrade,
# so one saved network prints as two rows ("wpa2-psk" and "wpa3-sae^") -- seen
# while proving this path.  Dedupe on the SSID.

android_ssids() {
	ash cmd wifi list-networks |
		awk 'NR > 1 && NF >= 3 {
			id = $1; $1 = ""; $NF = "";
			sub(/^[ \t]+/, ""); sub(/[ \t]+$/, "");
			if ($0 != "") print
		}' | sort -u
}

ANDROID_LIST=$(android_ssids)
if [ -z "$ANDROID_LIST" ]; then
	# Distinguish "Android has no saved networks" from "we could not ask".
	# Guessing wrong here deletes host profiles, so refuse rather than assume.
	#
	# Both answers must be recognised, and missing one of them is not a small
	# bug: with nothing saved Android prints the bare words "No networks" and no
	# "Network Id" header at all, so testing only for the header treats an EMPTY
	# Android as an unreadable one -- and empty is exactly the state in which
	# importing matters most. It made the first version a silent no-op after the
	# user forgot their last network.
	probe=$(ash cmd wifi list-networks)
	case "$probe" in
	*"Network Id"*|*"No networks"*) ;;
	*)
		log "could not read Android's saved networks -- doing nothing"
		exit 0
		;;
	esac
fi

android_has() {
	printf '%s\n' "$ANDROID_LIST" | grep -qxF "$1"
}

# ------------------------------------ stale (Waydroid) projection -> NM delete
#
# A network forgotten in Android leaves the daemon's own profile behind, PSK
# included.  Nothing reaped it: waydroid-wifid's NmBackend::forget() does
# exactly this job and NOTHING CALLS IT, because the seam that looks like the
# place to call it from is not one.
#
# ISupplicantStaIface.removeNetwork is the tempting hook and it is the wrong
# one.  Measured on bigtab01, one boot, --verbose, on a network that was never
# forgotten and was still connected at the end of it:
#
#   20:45:56 removeNetwork(1)
#   20:46:51 addNetwork() -> id 2      <- 55 s later, same SSID
#   20:47:14 removeNetwork(2)
#   20:47:22 addNetwork() -> id 3
#   21:50:20 removeNetwork(3)
#   21:50:28 addNetwork() -> id 4
#
# Android clears the supplicant's network list as part of the ORDINARY connect
# cycle -- the shim holds one network at a time -- so removeNetwork fires on
# every reconnect and never on a forget.  Wiring forget() there would have
# deleted the saved profile every time Wi-Fi was used, and under the
# primary-radio configuration of docs/38-wifi-primary-radio.md that profile is
# the one the host is administered over.  The signal does not exist at that
# seam, so the reconciliation happens here instead.
#
# OWNERSHIP IS BY UUID, NOT BY NAME, for the reason NmBackend.cpp's
# connectionId() spells out at length: connection.id is a display string, the
# desktop GUI can rename it and NM does not require it to be unique, so
# somebody naming a profile "coffeeshop (Waydroid)" would hand this function
# write access to it.  The daemon derives its UUIDs as RFC 4122 v5 over a fixed
# namespace and the SSID, reproducible from nothing but the SSID -- so we
# reproduce it and compare.  A profile whose UUID we can regenerate is ours;
# nothing else is, whatever it is called.

# The namespace from NmBackend::connectionUuid().  Changing it here orphans
# every profile the daemon has made, exactly as changing it there would.
WAYDROID_UUID_NS='\x7f\x86\x2e\xff\x2c\xb3\x41\xe0\xad\xa9\x31\x51\x20\x0e\xf9\x7f'

waydroid_uuid() {
	local h b6 b8
	h=$( { printf '%b' "$WAYDROID_UUID_NS"; printf '%s' "$1"; } |
	     sha1sum | cut -d' ' -f1 )
	# Version 5 into the high nibble of byte 6 and the RFC 4122 variant into
	# byte 8 -- the same two lines as the daemon's digest[6] and digest[8].
	b6=$(printf '%02x' "$(( (0x${h:12:2} & 0x0f) | 0x50 ))")
	b8=$(printf '%02x' "$(( (0x${h:16:2} & 0x3f) | 0x80 ))")
	printf '%s-%s-%s%s-%s%s-%s\n' \
		"${h:0:8}" "${h:8:4}" "$b6" "${h:14:2}" \
		"$b8" "${h:18:2}" "${h:20:12}"
}

# Ours iff the UUID is the one the daemon would have derived for this SSID.
is_ours() {
	[ "$1" = "$(waydroid_uuid "$2")" ]
}

# A wiped WifiConfigStore.xml makes every projection look forgotten at once, and
# honouring that is worse here than in the host-owned half: once Android has
# lost a passphrase, our profile holds THE LAST COPY OF IT.  A mass reap would
# destroy the user's passwords rather than merely unshare a network.  So this
# gets its own budget rather than a share of MAX_FORGETS_PER_RUN -- one person
# forgetting one network must not be rationed against the other half's activity,
# and a reset has to refuse in both halves independently.
MAX_REAPS_PER_RUN="${MAX_REAPS_PER_RUN:-1}"

stale=()
while IFS= read -r uuid; do
	[ -n "$uuid" ] || continue
	ssid=$(nmcli -g 802-11-wireless.ssid connection show "$uuid" 2>/dev/null)
	[ -n "$ssid" ] || continue
	is_ours "$uuid" "$ssid" || continue
	android_has "$ssid" && continue
	if nodelete_contains "$ssid"; then
		log "\"$ssid\" is gone from Android, but it is marked nodelete;" \
		    "leaving our profile alone"
		continue
	fi
	stale+=("$uuid|$ssid")
done < <(nmcli -t -f UUID,TYPE connection show 2>/dev/null |
         awk -F: '$2 == "802-11-wireless" { print $1 }')

if [ "${#stale[@]}" -gt "$MAX_REAPS_PER_RUN" ]; then
	log "${#stale[@]} of our profiles have no network in Android -- that is a" \
	    "reset, not somebody forgetting a network, and ours may be the last" \
	    "copy of those passphrases. Deleting nothing."
	for e in ${stale[@]+"${stale[@]}"}; do log "  (${e#*|})"; done
else
	for e in ${stale[@]+"${stale[@]}"}; do
		uuid=${e%%|*}
		ssid=${e#*|}

		# The active guard is the whole safety story for our own profiles, and
		# it is enough BECAUSE they are autoconnect=no projections: NM will
		# never raise one by itself, so a profile that is not up right now is
		# not something the host is relying on.
		#
		# canDelete()'s default-route guard is deliberately NOT applied here.
		# Under docs/38's primary-radio configuration every profile of ours is
		# pinned to the interface carrying the host's default route, so that
		# guard would refuse every reap there is -- the feature would install,
		# log nothing and do nothing, on the machine it was written for.
		active=$(nmcli -t -f UUID,DEVICE connection show --active 2>/dev/null |
		         awk -F: -v u="$uuid" '$1 == u { print $2 }')
		if [ -n "$active" ]; then
			log "\"$ssid\" is gone from Android, but our profile is active on" \
			    "$active; leaving it"
			continue
		fi

		# An autoconnect=yes profile is one somebody has promoted out of being
		# a projection, so it is no longer ours to reap even though the UUID
		# still says we made it.
		auto=$(nmcli -g connection.autoconnect connection show "$uuid" 2>/dev/null)
		if [ "$auto" = "yes" ]; then
			log "\"$ssid\" is gone from Android, but our profile has" \
			    "autoconnect=yes; somebody has adopted it, so leaving it"
			continue
		fi

		cid=$(nmcli -g connection.id connection show "$uuid" 2>/dev/null)
		log "\"$ssid\" is gone from Android; reaping our stale profile, which" \
		    "still holds its passphrase"
		if nmcli connection delete "$uuid" >/dev/null 2>&1; then
			log "  deleted NM profile \"${cid:-$uuid}\""
		else
			log "  could not delete NM profile \"${cid:-$uuid}\""
		fi
	done
fi

# ------------------------------------------------------------- the opt-in gate
#
# Everything past here concerns HOST-OWNED profiles, which are opt-in.  The reap
# above is not, which is why this exit is here and not at the top of the script.
if [ ! -r "$SHARE_CONF" ]; then
	log "no $SHARE_CONF -- nothing is opted in, so the host-owned half has" \
	    "nothing to do"
	exit 0
fi
if [ "${#WANTED[@]}" -eq 0 ]; then
	log "$SHARE_CONF names no networks"
	exit 0
fi
# ------------------------------------------------- Android forget -> NM delete
#
# THIS RUNS BEFORE THE IMPORT, AND THE ORDER IS LOAD-BEARING.
#
# With the import first, a network forgotten in Android is re-imported by the
# same run that then deletes its NM profile -- so "forget" leaves the network
# saved in Android and gone from NetworkManager, the exact inverse of what was
# asked for. Measured doing precisely that before the order was swapped.

# A profile is only deletable if losing it cannot cost this machine its network.
# The second adapter exists precisely so Android can never strand the host
# (docs/34-wifi-second-radio.md); a sync script able to delete the profile the
# host is connected through would hand that back.
canDelete() {
	local uuid="$1" ssid="$2" active hostdev devs

	active=$(nmcli -t -f UUID,DEVICE connection show --active 2>/dev/null |
	         awk -F: -v u="$uuid" '$1 == u { print $2 }')
	if [ -n "$active" ]; then
		log "  refusing to delete \"$ssid\": it is active on $active"
		return 1
	fi

	hostdev=$(ip -o route get 1.1.1.1 2>/dev/null |
	          grep -o 'dev [^ ]*' | awk '{print $2}')
	devs=$(nmcli -g connection.interface-name connection show "$uuid" 2>/dev/null)
	if [ -n "$hostdev" ] && [ "$devs" = "$hostdev" ]; then
		log "  refusing to delete \"$ssid\": pinned to $hostdev, which carries" \
		    "the host's default route"
		return 1
	fi
	return 0
}

PREV=()
deleted=()
[ -r "$STATE" ] && mapfile -t PREV < "$STATE"

# Candidates: networks we imported on a previous run, still opted in, whose NM
# profile still exists, and which Android no longer has. That combination means
# somebody forgot it in Android rather than that it was never there.
forgotten=()
for ssid in ${PREV[@]+"${PREV[@]}"}; do
	[ -n "$ssid" ] || continue
	wanted_contains "$ssid" || continue
	android_has "$ssid" && continue
	if nodelete_contains "$ssid"; then
		log "\"$ssid\" was forgotten in Android, but it is marked nodelete;" \
		    "leaving the host's profile alone"
		continue
	fi
	forgotten+=("$ssid")
done

if [ "${#forgotten[@]}" -gt "$MAX_FORGETS_PER_RUN" ]; then
	log "${#forgotten[@]} networks vanished from Android at once -- that is a" \
	    "reset, not somebody forgetting a network. Deleting nothing."
	log "  (${forgotten[*]})"
elif [ "${#forgotten[@]}" -gt 0 ]; then
	for ssid in ${forgotten[@]+"${forgotten[@]}"}; do
		log "\"$ssid\" was forgotten in Android; NM is the mirror, so removing it"
		deleted+=("$ssid")
		while IFS= read -r uuid; do
			[ -n "$uuid" ] || continue
			s=$(nmcli -g 802-11-wireless.ssid connection show "$uuid" 2>/dev/null)
			[ "$s" = "$ssid" ] || continue
			# The daemon's own projection, not a host-owned profile. The
			# reap above already handled it, on a rule of its own. Tested by
			# UUID and not by the " (Waydroid)" suffix: the suffix is a label
			# anyone can change, so a host profile somebody happened to name
			# that way was being spared from a deletion the owner opted into,
			# and a projection somebody renamed was being deleted by the wrong
			# half of the script under the wrong rules.
			is_ours "$uuid" "$ssid" && continue
			cid=$(nmcli -g connection.id connection show "$uuid" 2>/dev/null)
			canDelete "$uuid" "$ssid" || continue
			if nmcli connection delete "$uuid" >/dev/null 2>&1; then
				log "  deleted NM profile \"$cid\""
			else
				log "  could not delete NM profile \"$cid\""
			fi
		done < <(nmcli -t -f UUID,TYPE connection show 2>/dev/null |
		         awk -F: '$2 == "802-11-wireless" { print $1 }')
	done
fi

was_forgotten() {
	local s
	for s in ${forgotten[@]+"${forgotten[@]}"}; do [ "$s" = "$1" ] && return 0; done
	return 1
}

# --------------------------------------------------------- NM -> Android

# NM key-mgmt as the profile is CONFIGURED, which is the host's stated intent
# and therefore the thing to honour when the host is the source of truth.
# Android's add-network takes open|owe|wpa2|wpa3.
android_sectype() {
	case "$1" in
	none|"")    echo open ;;
	owe)        echo owe ;;
	sae)        echo wpa3 ;;
	wpa-psk|wpa-psk-sha256|wpa-ft-psk)
	            echo wpa2 ;;
	*)          echo "" ;;      # wpa-eap, wpa-eap-suite-b-192, ieee8021x, ...
	esac
}

imported=()

while IFS= read -r uuid; do
	[ -n "$uuid" ] || continue

	ssid=$(nmcli -g 802-11-wireless.ssid connection show "$uuid" 2>/dev/null)
	[ -n "$ssid" ] || continue
	wanted_contains "$ssid" || continue

	# Decided above to be a forget. Its profile has normally just been deleted,
	# but a guard may have spared one (an active profile, say) -- and importing
	# that would resurrect in Android the very network the user just removed.
	was_forgotten "$ssid" && continue

	# Never import the daemon's own projection of an Android network. It exists
	# because Android already knows that network, so importing it would be a
	# loop -- and its credentials came FROM Android in the first place.
	# By UUID, for the reason given in the reap above.
	is_ours "$uuid" "$ssid" && continue

	km=$(nmcli -g 802-11-wireless-security.key-mgmt connection show "$uuid" 2>/dev/null)
	sectype=$(android_sectype "$km")
	if [ -z "$sectype" ]; then
		log "skipping \"$ssid\": key-mgmt \"$km\" is not carried across this seam"
		continue
	fi

	psk=""
	if [ "$sectype" != "open" ] && [ "$sectype" != "owe" ]; then
		psk=$(nmcli -s -g 802-11-wireless-security.psk connection show "$uuid" 2>/dev/null)
		if [ -z "$psk" ]; then
			# psk-flags may say the secret is agent-owned rather than stored in
			# the profile, in which case there is nothing here to copy.
			log "skipping \"$ssid\": NetworkManager holds no passphrase for it"
			continue
		fi
	fi

	# ADD MISSING NETWORKS; NEVER OVERWRITE ONE ANDROID ALREADY HAS.
	#
	# This is a safety property, not an optimisation -- `add-network` is
	# documented as "Add/update saved network", so re-running it WOULD clobber
	# the existing config, and clobbering it is exactly the wrong move.
	#
	# The host profile's key-mgmt is not a reliable statement of what Android
	# should use.  On this machine the host joins "vidiot" with wpa-psk over
	# wlp1s0 perfectly well, while Android over the T3U can only complete the
	# handshake with SAE (docs/34-wifi-second-radio.md) -- so importing the
	# host's "wpa-psk" over Android's working "wpa3-sae" would break a
	# connection that works, using a mapping we know to be unreliable.
	#
	# The cost is that a passphrase changed on the host does not propagate to a
	# network Android already knows.  That is a real limit of "NM is the source
	# of truth" here, and it is the conservative side to err on: forget the
	# network in Android and the next sync imports it afresh.
	if android_has "$ssid"; then
		imported+=("$ssid")
		continue
	fi

	log "importing \"$ssid\" ($sectype) into Android"
	if [ -n "$psk" ]; then
		out=$(ash cmd wifi add-network "$ssid" "$sectype" "$psk")
	else
		out=$(ash cmd wifi add-network "$ssid" "$sectype")
	fi

	# `imported` becomes the state file, and the state file is what licenses a
	# DELETION next run -- so it must mean "confirmed present in Android", never
	# "we tried".  Recording a failed import would make the next run see the
	# network missing from Android, read that as a forget, and delete the host's
	# profile.  A failed import must therefore leave no trace at all.
	case "$out" in
	*"Save successful"*)
		log "  imported \"$ssid\""
		imported+=("$ssid")
		;;
	*)
		log "  FAILED to import \"$ssid\": ${out:-no output}"
		;;
	esac
done < <(nmcli -t -f UUID,TYPE connection show 2>/dev/null |
         awk -F: '$2 == "802-11-wireless" { print $1 }')

# Record what is confirmed present in Android NOW, minus anything just deleted.
# Leaving a deleted network in the state file would make the next run see it
# missing from Android all over again, spend the mass-forget budget on it, and
# hunt for a profile that is already gone.
was_deleted() {
	local s
	for s in ${deleted[@]+"${deleted[@]}"}; do [ "$s" = "$1" ] && return 0; done
	return 1
}

mkdir -p "$(dirname "$STATE")" 2>/dev/null
: > "$STATE"
for ssid in ${imported[@]+"${imported[@]}"}; do
	wanted_contains "$ssid" || continue
	was_deleted "$ssid" && continue
	printf '%s\n' "$ssid" >> "$STATE"
done

exit 0
