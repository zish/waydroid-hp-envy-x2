# waydroid-pwd capability policy. See docs/56-pipewire-control.md.
#
# Copy to /etc/waydroid-pwd/policy.conf (preferred) or to the daemon's state
# directory, ~/.local/state/waydroid-pwd/policy.conf. Without either file the
# defaults below apply, which are the values shown here.
#
# `key = value`, one per line, yes/no. Not INI and not YAML: this repository has
# no YAML parser and does not want one (packaging/gen-spec.sh says why about .mod
# files), and eight keys do not need sections.
#
# WHAT THE GATES ARE ACTUALLY PROTECTING
#
# Anything inside the container that holds the token can call any enabled verb.
# The token is in the app's private directory, which the kernel protects by uid
# even though SELinux is disabled inside the container -- so in practice that
# means the patchbay app, and anything running as its uid. These gates decide
# what that is allowed to be.

# Volume, mute, default sink/source, device profiles and routes. Reversible,
# audible, and the thing the app is mostly for.
mixer = yes

# Creating and destroying links between ports -- the patchbay proper.
links = yes

# Links whose SOURCE is a capture device or a sink's monitor port. Split out
# from `links` because making one is mechanically identical to making any other
# link, so it cannot be caught by looking at the verb: only at the ports. A
# monitor port carries everything the desktop is playing and an Audio/Source
# carries the microphone, so this one is a recording tap and stays off until
# somebody decides otherwise.
links.capture = no

# clock.force-quantum, clock.force-rate and WirePlumber settings. Affects the
# whole host graph, not just Android's stream -- which is the point if the goal
# is lowering the latency floor docs/44 measured at quantum 1024, and a reason
# to think about it if not.
graph = yes

# Creating supervised nodes: pw-loopback instances, and with `modules` also on,
# module instances hosted in their own `pipewire -c` process. These appear in
# the host's graph and persist until destroyed or until the daemon stops.
nodes = no

# Module instances specifically (filter-chain, echo-cancel, combine-stream).
# Needs `nodes` as well. The most powerful verb here by some distance: a filter
# chain can do anything to anything it is linked to.
modules = no

# Moving a filter graph's control ports -- an EQ band's Freq/Q/Gain, a delay
# time, a noise gate's threshold. On by default, because it is the same kind of
# thing as `mixer`: audible, reversible, and useless to gate if the point is an
# effects UI that can move a slider.
#
# What keeps it that small is that node-param will only set a control the node
# ALREADY advertises on its filter graph. A filter-chain node's Props param has
# a second entry belonging to audioconvert, and `debug.wav-path` lives in it --
# that key writes the node's audio to a file, so it is a recording tap by
# another name, and the same concern `links.capture` exists for. Filter control
# names always carry a colon and audioconvert's never do, which is the line the
# verb refuses to cross.
#
# This gate does NOT create effects. A chain has to exist first, which means
# either `nodes` + `modules`, or a conf.d drop-in the owner wrote by hand.
params = yes

# Writing a filter chain's live control values back into the conf.d drop-in
# that declares it, so they survive the chain stopping. Off by default, and
# NOT folded into `params`, because the two are different kinds of act: moving
# a slider is audible, reversible and confined to the running graph, while
# this writes a file the audio server executes at every start afterwards. It
# is also the only verb here that reaches outside the graph to the filesystem.
#
# What it will touch is one file: the single drop-in under
# ~/.config/pipewire/filter-chain.conf.d/ that declares the node being saved,
# found by parsing each candidate rather than by matching text. It rewrites
# only the bytes between the braces of a `control = { }` block, keeps the
# file's comments, refuses if the result will not parse, and leaves the
# previous contents in a .bak beside it. It creates no chains and deletes
# none.
#
# It does not restart anything. The running chain is already in the state
# being written, so the file only matters at the next start -- and restarting
# filter-chain.service would destroy and recreate the sink, which on a host
# where that sink is the default would bump every playing stream off it.
config = no
