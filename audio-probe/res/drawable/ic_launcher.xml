<?xml version="1.0" encoding="utf-8"?>
<!-- A sine wave crossing a narrow gate: low latency. Vector drawable so there
     are no density buckets to generate. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp" android:height="48dp"
    android:viewportWidth="48" android:viewportHeight="48">
    <path android:fillColor="#004D40"
        android:pathData="M0,0h48v48h-48z" />
    <!-- the gate: two posts the wave has to fit between -->
    <path android:fillColor="#4DB6AC"
        android:pathData="M19,8 h3 v32 h-3 z" />
    <path android:fillColor="#4DB6AC"
        android:pathData="M26,8 h3 v32 h-3 z" />
    <!-- one cycle of a sine, drawn through the gate -->
    <path android:strokeColor="#FFD54F" android:strokeWidth="3"
        android:fillColor="#00000000" android:strokeLineCap="round"
        android:pathData="M4,24 C8,10 14,10 18,24 C22,38 28,38 32,24 C36,10 42,10 44,24" />
</vector>
