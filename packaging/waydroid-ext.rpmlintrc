# rpmlint filters for this repository's packages.
#
#     rpmlint -r packaging/waydroid-ext.rpmlintrc build/rpm/RPMS/*/*.rpm
#
# packaging/build-mod.sh --lint passes it automatically.
#
# Note it is an rpmlintrc (-r), NOT a config file (-c). rpmlint 2.7 loads
# Filters = [...] out of a TOML config and then does not apply them -- they show
# up in --print-config and filter nothing. addFilter() in an rpmlintrc works.
#
# Every filter here is a check that is correct in general and inapplicable to
# these packages, with the reason. Nothing is filtered for being noisy.
#
# DELIBERATELY NOT FILTERED, because they are real and unfixed:
#
#   no-signature          the packages are unsigned. They must be signed before
#                         any of them is published. docs/47-package-split.md.
#   invalid-url Source0   Source0 is a bare filename because there is no release
#                         download URL yet. It becomes a real URL at first release.
#   no-%check-section     true of the group and host packages. Overlay components
#                         do have one -- it verifies the staged payload against
#                         the manifest -- and the others should grow one.

# ---------------------------------------------------------------- foreign ELF
#
# The overlay payload is x86_64 and x86 shared objects built for Android 13 and
# loaded by processes inside the container, never by anything on the host.
# rpmlint reads them as host libraries and applies host-library rules, which
# produces four complaints about the same fact.
#
# 0644 is Android's convention for /vendor/lib64, it is the mode the working
# overlay on the reference machine has, and it is recorded in the component
# manifest -- a deliberate value, not a slip.
addFilter("shared-library-not-executable.*waydroid-overlay")
# These files must be named exactly what Android's linker looks for, which is
# unversioned. A versioned soname would simply not be found.
addFilter("invalid-soname.*waydroid-overlay")
addFilter("non-versioned-file-in-library-package.*waydroid-overlay")
# Built by the Android NDK, which does not emit the section rpmlint wants. Not
# ours to add, and adding it would change bytes verified against a running system.
addFilter("missing-hash-section.*waydroid-overlay")
# Unstripped on purpose: the specs set %__brp_strip to %nil because these are
# the exact bytes compared by sha256 against the reference machine and recorded
# in the component manifest. Stripping them would make the package's payload
# disagree with its own manifest, which the %check would then fail.
addFilter("unstripped-binary-or-object.*waydroid-overlay")

# ------------------------------------------------------------------- the path
#
# %{_prefix}/lib, not %{_libdir}: this is package data that the reconciler reads,
# not a linkable library, so it must not land in /usr/lib64 on a multilib host.
# systemd, udev and dracut all stage into %{_prefix}/lib for the same reason.
addFilter("hardcoded-library-path.*waydroid-overlay")
# A derive row names the path its input occupies INSIDE the user's own
# vendor.img -- /lib/camera.device@3.4-external-impl.so is an Android path in an
# ext2 image that debugfs reads, and it is not a path on the host filesystem at
# all. It can no more be %{_libdir} than a path inside a tarball could: the image
# was built by somebody else and the file is where they put it. Named for the one
# package whose in-image path starts with /lib, so that another one has to be
# looked at rather than inheriting the exemption.
addFilter("waydroid-ext-camera-hal.*hardcoded-library-path in /lib/camera")

# ---------------------------------------------------------- obsolete rpm tags
#
# Group: and BuildRoot: have been obsolete since rpm 4.6; Fedora's guidelines
# forbid Group: outright. Packager: is set by the build system, not the spec.
addFilter("no-group-tag")
addFilter("no-buildroot-tag")
addFilter("no-packager-tag")

# --------------------------------------------------------- build-host artefact
#
# rpmlint on a Debian build host has no SPDX identifier list, so every correct
# SPDX expression is reported invalid; on a Fedora builder these do not fire.
# Filtered by identifier rather than wholesale, so a genuinely wrong licence
# string still shows up.
addFilter("invalid-license (GPL-3.0-or-later|Apache-2.0|MIT)$")

# rpmlint infers a locale subpackage from the "-gbm" suffix of the package name.
# There is no locale content here at all.
addFilter("no-dependency-on locales-gbm")
# The same inference from "-btd". Same answer: no locale content anywhere.
addFilter("no-dependency-on locales-btd")
# And from the "-hal" of camera-hal. Nothing in that package is a translation
# either; it is a vendor .so and an XML configuration file.
addFilter("no-dependency-on locales-hal")

# ------------------------------------------------------- tools named like libs
#
# libselinux-utils is where selinuxenabled lives. rpmlint reads any lib* name as
# a shared library that the automatic dependency generator should have found,
# but this is a dependency on a COMMAND used by a scriptlet, which nothing can
# infer from the payload. Scoped to the one package that needs it.
addFilter("waydroid-ext-backlight.*explicit-lib-dependency libselinux-utils")

# ------------------------------------------------- udev rules and nothing else
#
# waydroid-ext-backlight ships one udev rule and one CIL file, so its only entry
# under %{_prefix}/lib is that rule. The check exists to catch a library package
# that forgot its libraries; a udev rule is exactly where udev requires it.
addFilter("waydroid-ext-backlight.*only-non-binary-in-usr-lib")
# Three overlay components carry no ELF at all -- an init .rc, a feature
# permission XML, a VINTF manifest fragment -- so their whole staged payload is
# text under %{_prefix}/lib/waydroid-overlay. That is the staging directory the
# reconciler reads, not a library directory, and the components that DO ship
# Android ELF put it in exactly the same place. Named individually rather than
# by a wildcard, so that a fourth package tripping this has to be looked at.
#
# camera-hal and battery joined them on 2026-09-26 and for a different reason
# worth keeping distinct: they used to ship Android ELF and deliberately stopped.
# Both are now derive rows, which carry a stock hash, a result hash and a list of
# byte offsets instead of the patched vendor binary itself -- so the package that
# used to be 400 KB of somebody else's ELF is a manifest and nothing else
# (docs/54-no-vendored-binaries.md). An empty-looking package is exactly right
# here, and the check has no way to know that.
addFilter("waydroid-ext-(brightness-overlay|wifi-framework|wifi-hostd|camera-hal|battery).*only-non-binary-in-usr-lib")

# ------------------------------------ a package that is a patch, not a binary
#
# Same two packages, same cause, and this one is an E rather than a W. rpmlint
# reasons that an ExclusiveArch package with no ELF in it should have been
# noarch, and for an ordinary package that is sound advice. It is wrong here and
# the arch is deliberate: a derive row's patch offsets are valid only against the
# x86_64 Android build of that binary, so the package IS architecture-specific
# even though its payload is text. ExclusiveArch makes an aarch64 host refuse it
# on the shelf, which is the same reason docs/47-package-split.md gives for the
# components that do carry ELF. Installing it there would now fail safe anyway --
# the stock hash would not match and the reconciler would refuse rather than
# deploy anything -- but failing before installation beats failing at boot.
addFilter("waydroid-ext-(camera-hal|battery).*no-binary")

# ------------------------------------------- rm of our own state on uninstall
#
# waydroid-ext-backlight's %postun removes /var/lib/waydroid-backlight/policy.sha256,
# the stamp recording which CIL the loader last installed. The check is right to
# be suspicious of rm in a scriptlet -- it is how a package deletes somebody
# else's data -- but this path is written by this package's own loader, is a
# fixed literal with no variable in it, and is meaningless once the module is
# gone. Leaving it behind would make a later reinstall believe the policy was
# already current and skip the load.
addFilter("waydroid-ext-backlight.*dangerous-command-in-%postun rm")

# ------------------------------------------------------------------- spelling
#
# A blanket filter, and the only one here. These descriptions are mostly Android
# and Linux identifiers -- minigbm, wificond, gbinder, dexopt, VINTF, udev,
# autosuspend, Waydroid -- none of which any dictionary has, and rpmlint's
# suggestions are actively wrong: it offers "minicam" for "minigbm". Keeping the
# check would mean adding a word per modification forever and reading past the
# noise anyway, which is how a real typo gets missed. Descriptions are reviewed
# by a human instead.
addFilter("spelling-error")
